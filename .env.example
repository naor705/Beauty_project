# =====================================================
# Beauty Researcher — Environment Variables
# Copy this file to .env and fill in real values.
# =====================================================

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
NICHE=beauty care

# --- Database ---
# SQLite path (default). For Postgres swap the driver in src/db/client.ts.
DATABASE_URL=file:./data/beauty_research.db

# --- LLM provider: "anthropic" | "openai" | "mock" ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Research provider ---
# Which source to use for trend research:
#   "mock"   → built-in fake data (default, free, always works)
#   "graph"  → official Instagram Graph API (free, requires Meta setup — see docs/META_SETUP.md)
#   "apify"  → managed scraping via Apify actors (paid, ~$0-30/mo, no Meta approval needed)
RESEARCH_PROVIDER=mock

# --- Apify (used when RESEARCH_PROVIDER=apify) ---
APIFY_TOKEN=
APIFY_IG_ACTOR=apify/instagram-hashtag-scraper
APIFY_TT_ACTOR=clockworks/free-tiktok-scraper

# --- Social research APIs (only used when RESEARCH_PROVIDER=graph) ---
# TODO: Apply for TikTok Research API and Instagram Graph API access.
TIKTOK_API_KEY=
TIKTOK_API_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Image generation ---
# Provider: "openai" | "blotato" | "mock"
IMAGE_PROVIDER=mock
IMAGE_API_KEY=

# --- Video generation ---
# Provider: "creatomate" | "runway" | "pika" | "blotato" | "mock"
VIDEO_PROVIDER=mock
CREATOMATE_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=

# --- Blotato (covers video/image generation + multi-platform publishing) ---
BLOTATO_API_KEY=
BLOTATO_BASE_URL=https://backend.blotato.com/v2
# Account IDs from your Blotato dashboard (Settings → Accounts). Required for publishing.
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=
# Default video creation template ID (GET /v2/videos/templates to discover yours).
BLOTATO_DEFAULT_VIDEO_TEMPLATE_ID=
# Set to true to use Blotato as the publishing provider (replaces TikTok/IG direct APIs).
PUBLISH_VIA_BLOTATO=false

# --- Notifications ---
# Channel: "telegram" | "email" | "console"
NOTIFY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
# The single chat that can APPROVE/REJECT (e.g. the brand owner). Required.
TELEGRAM_CHAT_ID=
# Optional: comma-separated chat IDs that receive a view-only copy of every
# approval message (no buttons). Useful for collaborators who should be
# informed but should not be able to approve. Example: "539033429,123456789"
TELEGRAM_VIEWER_CHAT_IDS=
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Scheduling ---
# Cron expressions. Defaults: research every day at 06:00, report every 3 days at 09:00.
RESEARCH_CRON=0 6 * * *
REPORT_CRON=0 9 */3 * *
TIMEZONE=UTC

# --- Safety ---
# When true, publishing agent never calls real APIs even with credentials present.
DRY_RUN=true
